---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: '联系我',
  description: '通过联系表单向 brokenvase 发送邮件。',
};
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-24">
    <div
      class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-900 sm:p-10"
    >
      <p class="text-primary text-sm font-semibold tracking-[0.18em]">联系我</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">发送一封邮件</h1>
      <p class="mt-4 text-slate-600 dark:text-slate-300">
        如果你想讨论文章内容或指出问题，可以通过下面的表单联系我。请不要填写密码等敏感信息。
      </p>

      <form id="contact-form" class="mt-8 space-y-5">
        <div>
          <label for="name" class="block text-sm font-medium text-slate-700 dark:text-slate-200">称呼</label>
          <input
            id="name"
            name="name"
            type="text"
            autocomplete="name"
            minlength="1"
            maxlength="80"
            required
            class="focus:border-primary focus:ring-primary/20 mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 outline-none transition focus:ring-2 dark:border-slate-600 dark:bg-slate-950 dark:text-white"
          />
        </div>

        <div>
          <label for="email" class="block text-sm font-medium text-slate-700 dark:text-slate-200">邮箱</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            maxlength="254"
            required
            class="focus:border-primary focus:ring-primary/20 mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 outline-none transition focus:ring-2 dark:border-slate-600 dark:bg-slate-950 dark:text-white"
          />
        </div>

        <div>
          <label for="subject" class="block text-sm font-medium text-slate-700 dark:text-slate-200">主题</label>
          <input
            id="subject"
            name="subject"
            type="text"
            minlength="2"
            maxlength="120"
            required
            class="focus:border-primary focus:ring-primary/20 mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 outline-none transition focus:ring-2 dark:border-slate-600 dark:bg-slate-950 dark:text-white"
          />
        </div>

        <div>
          <label for="message" class="block text-sm font-medium text-slate-700 dark:text-slate-200">内容</label>
          <textarea
            id="message"
            name="message"
            rows="7"
            minlength="5"
            maxlength="5000"
            required
            class="focus:border-primary focus:ring-primary/20 mt-2 w-full resize-y rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 outline-none transition focus:ring-2 dark:border-slate-600 dark:bg-slate-950 dark:text-white"
          ></textarea>
        </div>

        <div class="hidden" aria-hidden="true">
          <label for="website">网站</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="flex flex-wrap items-center gap-4">
          <button
            type="submit"
            class="bg-primary hover:bg-secondary focus-visible:ring-primary rounded-full px-6 py-3 text-sm font-semibold text-white shadow-sm transition focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-60"
          >
            发送邮件
          </button>
          <p id="form-status" class="text-sm text-slate-600 dark:text-slate-300" role="status" aria-live="polite"></p>
        </div>
      </form>

      <noscript>
        <p class="mt-6 text-sm text-amber-700 dark:text-amber-300">此表单需要启用 JavaScript。</p>
      </noscript>
    </div>
  </section>

  <script>
    const form = document.querySelector<HTMLFormElement>('#contact-form');
    const status = document.querySelector<HTMLElement>('#form-status');
    const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity() || !status || !submit) return;

      submit.disabled = true;
      status.textContent = '正在发送…';

      const values = Object.fromEntries(new FormData(form).entries());

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(values),
        });
        const result = (await response.json()) as { message?: string };

        if (!response.ok) throw new Error(result.message || '发送失败，请稍后重试。');

        form.reset();
        status.textContent = result.message || '邮件已经发送，谢谢你的来信。';
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : '发送失败，请稍后重试。';
      } finally {
        submit.disabled = false;
      }
    });
  </script>
</Layout>
