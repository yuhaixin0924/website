---
import { Image } from 'astro:assets';

import avatar from '~/assets/images/avatar.jpg';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: '关于我',
  description: '一个计算机专业的学生。',
};
---

<Layout metadata={metadata}>
  <section class="mx-auto flex min-h-[70vh] max-w-3xl items-center px-4 py-16 sm:px-6 sm:py-24">
    <div
      class="w-full rounded-3xl border border-slate-200 bg-white px-6 py-10 text-center shadow-sm dark:border-slate-700 dark:bg-slate-900 sm:px-12 sm:py-14"
    >
      <div
        class="mx-auto h-28 w-28 overflow-hidden rounded-full bg-slate-100 shadow-lg ring-4 ring-white dark:bg-slate-800 dark:ring-slate-800"
      >
        <Image
          src={avatar}
          alt="brokenvase 的头像"
          width={224}
          loading="eager"
          class="h-full w-full object-cover"
          style="object-position: 42% 50%;"
        />
      </div>

      <p class="mt-7 text-sm font-semibold tracking-[0.18em] text-primary-600 dark:text-primary-400">关于我</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">brokenvase</h1>
      <p class="mt-4 text-lg text-slate-600 dark:text-slate-300">一个计算机专业的学生</p>

      <div class="mt-6 flex flex-wrap items-center justify-center gap-2" aria-label="正在学习的内容">
        <span class="text-sm text-slate-500 dark:text-slate-400">正在学习</span>
        <span
          class="rounded-full bg-primary-50 px-3 py-1 text-sm font-semibold text-primary-700 ring-1 ring-inset ring-primary-200 dark:bg-primary-950 dark:text-primary-300 dark:ring-primary-800"
        >
          CSAPP
        </span>
      </div>

      <a
        href="https://github.com/yuhaixin0924"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 inline-flex items-center gap-2 rounded-full bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200 dark:focus:ring-offset-slate-900"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" class="h-4 w-4 fill-current">
          <path
            fill-rule="evenodd"
            d="M12 2C6.477 2 2 6.486 2 12.021c0 4.428 2.865 8.184 6.839 9.504.5.093.682-.217.682-.483 0-.237-.009-.866-.014-1.7-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.621.069-.609.069-.609 1.003.071 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.091-.647.349-1.088.635-1.338-2.221-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.987 1.029-2.688-.103-.254-.446-1.272.098-2.65 0 0 .84-.269 2.75 1.026A9.564 9.564 0 0 1 12 6.84a9.59 9.59 0 0 1 2.504.337c1.909-1.295 2.748-1.026 2.748-1.026.546 1.378.203 2.396.1 2.65.64.701 1.028 1.595 1.028 2.688 0 3.848-2.337 4.695-4.566 4.943.359.31.679.923.679 1.86 0 1.343-.012 2.426-.012 2.756 0 .268.18.58.688.481A10.025 10.025 0 0 0 22 12.021C22 6.486 17.523 2 12 2Z"
            clip-rule="evenodd"></path>
        </svg>
        GitHub
      </a>
    </div>
  </section>
</Layout>
