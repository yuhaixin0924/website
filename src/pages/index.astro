---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'brokenvase 的学习笔记',
  description: '记录算法导论、数据结构、数学与计算机基础的个人学习博客。',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: '查看博客',
        href: '/blog',
      },
      { text: '关于我', href: '/about' },
    ]}
    image={{ src: '~/assets/images/hero-image.jpg', alt: 'brokenvase 的学习笔记' }}
  >
    <Fragment slot="title"> brokenvase 的学习笔记 </Fragment>

    <Fragment slot="subtitle"> 记录算法导论、数据结构、数学与计算机基础的个人学习博客。 </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <!-- Features Widget *************** -->

  <!-- Content Widget **************** -->

  <!-- Content Widget **************** -->

  <!-- Steps Widget ****************** -->

  <!-- Features2 Widget ************** -->

  <!-- HighlightedPosts Widget ******* -->

  <BlogLatestPosts title="最近文章" linkText="查看全部文章" />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="关于这个博客"
    tagline="学习记录"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: '为什么搭建这个博客？',
        description: '记录算法导论的学习内容，同时激励自己继续学习计算机网络、数据结构和算法相关知识。',
      },
    ]}
  />

  <!-- Stats Widget ****************** -->

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: '在 GitHub 查看源码',
        href: 'https://github.com/yuhaixin0924/website',
        target: '_blank',
        icon: 'tabler:download',
      },
    ]}
  >
    <Fragment slot="title"> 本站代码公开在 GitHub </Fragment>
  </CallToAction>
</Layout>
